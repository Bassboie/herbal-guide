# ==============================================================================
# HERBAL GUIDE - ENVIRONMENT CONFIGURATION EXAMPLE (NO SECRETS COMMITTED)
# Store real production values in Netlify Site Environment Variables (or server env).
# ==============================================================================

# Public App Base URL (Required in production to prevent callback spoofing & CORS bypass)
APP_URL="https://your-site.netlify.app"

# Comma-separated list of allowed frontend origins for API CORS (optional; defaults to APP_URL)
ALLOWED_ORIGINS="https://your-site.netlify.app"

# PAYSTACK_SECRET_KEY: Server-side ONLY (sk_test_... for test mode, sk_live_... for live).
# NEVER prefix with VITE_ or expose in frontend code.
PAYSTACK_SECRET_KEY="sk_live_replace_in_env"

# PAYSTACK_PUBLIC_KEY: Public key matching your secret key mode (loaded via /api/paystack/config).
PAYSTACK_PUBLIC_KEY="pk_live_replace_in_env"
# VITE_PAYSTACK_PUBLIC_KEY: Optional build-time public key (must match server mode).
VITE_PAYSTACK_PUBLIC_KEY="pk_live_replace_in_env"

# PDF_TOKEN_SECRET: Dedicated 32+ character random secret for signing expiring PDF links & HttpOnly cookies.
# Required across serverless Netlify Functions so download tokens stay valid between invocations.
# Generate with: openssl rand -hex 32
PDF_TOKEN_SECRET="replace_with_64_hex_char_random_secret"

# PRIVATE PDF STORAGE (Choose ONE server-only source; NEVER place PDF inside public/ or dist/)
# Option A: Private local file path relative to project root (outside public/ and dist/)
PRIVATE_PDF_PATH=""
# Option B: Private Supabase Storage bucket & object key (bucket must have public = false)
SUPABASE_PDF_BUCKET="private-ebooks"
SUPABASE_PDF_PATH="herbal-guide-handbook.pdf"
# Option C: Private server-only HTTPS download URL (stored only in Secrets, never sent to client)
PDF_SOURCE_URL=""

# SUPABASE SERVER-SIDE CREDENTIALS (Server-side ONLY via service_role; NEVER expose to browser)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_with_service_role_key_in_secrets"

# OPTIONAL SERVER-SIDE EMAIL DELIVERY (Resend API - sends short-lived signed download link only)
RESEND_API_KEY=""
EMAIL_FROM="Herbal Guide <no-reply@your-domain.com>"
